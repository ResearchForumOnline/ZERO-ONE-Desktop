{
  "name": "zero-one-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "ZERO ONE desktop command center for ZMail, ZeroThink, OpenZero, CallChat, and the local ZSEC Shield preview.",
  "author": "QUANTUMENCRYPTION1 LTD",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "pack:win": "npm run check && npm run verify:zsec && electron-builder --win dir --x64",
    "dist:win": "npm run check && npm run verify:zsec && electron-builder --win nsis --x64",
    "stage:zsec": "pwsh -NoProfile -File scripts/stage-zsec-vendor.ps1",
    "verify:zsec": "node build/zsec-vendor-verifier.cjs vendor/zsec-shield vendor/zsec-shield.lock.json"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "org.talktoai.zeroone",
    "productName": "ZERO ONE",
    "artifactName": "ZERO-ONE-${version}-${os}-${arch}.${ext}",
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/zsec-shield",
        "to": "zsec-shield",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/zsec-shield.lock.json",
        "to": "zsec-shield-provenance.json"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/zero-one-icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZERO ONE",
      "deleteAppDataOnUninstall": false
    },
    "beforePack": "build/beforePack.cjs"
  },
  "type": "module"
}
